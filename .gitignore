cat > .gitignore << 'EOF'
# ============================
#  Python / общее
# ============================
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
*.dylib
*.dll
*.egg-info/
*.egg
dist/
build/
.eggs/
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.dmypy.json
dmypy.json
*.log
*.out
*.err

# ============================
#  Виртуальное окружение
# ============================
venv/
env/
.venv/
.env
.env.local
.env.*.local

# ============================
#  Редакторы и IDE
# ============================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================
#  Jupyter Notebooks
# ============================
.ipynb_checkpoints/
# *.ipynb   # раскомментируйте, если не хотите версионировать ноутбуки

# ============================
#  Модели, адаптеры и большие файлы
# ============================
model/base/
model/merged/
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.h5
*.pb
*.onnx

# ============================
#  Кэш Hugging Face, Datasets, Transformers
# ============================
cache/
.cache/
~/.cache/huggingface/

# ============================
#  Результаты экспериментов и логи
# ============================
results/
logs/
experiments/*/
!experiments/*/config.yaml

# ============================
#  ДАННЫЕ (большие файлы — не в Git)
# ============================
# 1. Игнорируем сырые и предобработанные датасеты
data/raw/
data/processed/
data_preproc_CG_SFT/          # <-- добавлено: папка с большим JSONL, который вызвал ошибку
*.jsonl                       # <-- если все .jsonl не нужны в Git (иначе укажите конкретные папки)
*.csv                         # <-- раскомментировал, т.к. обычно большие
*.parquet                     # <-- раскомментировал, т.к. обычно большие
# Если какие-то .jsonl или .csv нужны для кода (например, конфиги), положите их в отдельную папку и игнорируйте только большие.

# ============================
#  ВЫВОДЫ БЕНЧМАРКОВ И ТЕСТОВ
# ============================
benchmark_output/
terminal_bench_results/
cybench_results/
seceval_results/
benchmarks/                    # <-- добавлено: если в папке benchmarks хранятся большие сгенерированные файлы

# ============================
#  ПАПКИ С БОЛЬШИМИ ВРЕМЕННЫМИ ДАННЫМИ
# ============================
data_collector/joern/          # уже было
/joern

# ============================
#  Докер / временные файлы
# ============================
*.tmp
docker-compose.override.yml
Dockerfile.*.local

# ============================
#  Системные
# ============================
*.swp
*.swo
*.lock
EOF

# TensorBoard logs
*.tfevents*
events.out.tfevents.*

# Чекпоинты и выходные папки
output/
logs/
*.log
checkpoint-*/

*.jsonl
*.json
*.jinja

*.jsonl
/models/
__pycache__/
*.pyc
.env
.vscode/
.idea/